{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(git checkout -b *)",
      "Bash(git checkout main)",
      "Bash(git fetch)",
      "Bash(git log:*)",
      "Bash(git pull)",
      "Bash(git pull --ff-only)",
      "Bash(python -m py_compile:*)"
    ],
    "deny": [
      "Bash(brew:*)"
    ],
    "defaultMode": "default"
  },
  "effortLevel": "medium",
  "preferredNotifChannel": "iterm2_with_bell"
}
